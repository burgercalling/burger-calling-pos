APP_NAME=Burger Calling POS API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/burger_calling_pos?sslmode=require

JWT_SECRET_KEY=replace-with-64-char-cryptographically-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

COOKIE_NAME=bc_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:3000

INITIAL_SUPERADMIN_USERNAME=superadmin
INITIAL_SUPERADMIN_PASSWORD=ChangeMeStrongPassword!123
INITIAL_SUPERADMIN_NAME=Burger Calling Super Admin

UPLOAD_ROOT=app/uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
